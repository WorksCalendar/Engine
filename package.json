{
  "name": "works-calendar-engine",
  "version": "1.0.0",
  "description": "Framework-agnostic scheduling state machine with rule-based conflict detection.",
  "license": "MIT",
  "author": "Nathan Horstmeier <natehorst240@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WorksCalendar/Engine.git"
  },
  "bugs": {
    "url": "https://github.com/WorksCalendar/Engine/issues"
  },
  "homepage": "https://github.com/WorksCalendar/Engine#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit -p tsconfig.build.json",
    "api:update": "api-extractor run --local",
    "api:check": "api-extractor run",
    "check": "npm run type-check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "date-fns": "^3.6.0 || ^4.0.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.7",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.8",
    "date-fns": "^3.6.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "keywords": [
    "scheduling",
    "calendar",
    "conflict-detection",
    "state-machine",
    "framework-agnostic"
  ]
}
